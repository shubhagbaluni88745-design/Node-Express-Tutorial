{
  "info": {
    "_postman_id": "789123ab-4567-89cd-ef01-234567890abc",
    "name": "CampusEats Secured API",
    "description": "Postman Collection for CS543 Web Services Tutorial 09 (Securing the API). Tests JWT authentication, role-based authorization (customer vs restaurant), and REST endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "restaurantToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Customer Login (Asha)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Token received and stored\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.collectionVariables.set('customerToken', jsonData.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@campus.edu\",\n  \"password\": \"customer123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Logs in as customer (Asha) and captures the customerToken variable."
      },
      "response": []
    },
    {
